<% if sedes.blank? %>
  <tr>
    <td colspan="3">No hay sedes disponibles para las especialidades seleccionadas.</td>
  </tr>
<% else %>
  <% sedes.each do |s| %>
    <tr>
      <td>
        <div class="checkboxConvContainer">
          <input type="checkbox" class="checkbox rowCheckboxSede" name="sedes_codigos[]" value="<%= s[:id_facultad] %>">
          Seleccionar
        </div>
      </td>
      <td><%= h(s[:nombre]) %></td>
      <td><%= h(s[:extensiones]) %></td>
    </tr>
  <% end %>
<% end %>
