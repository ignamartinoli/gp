<% if sedes.blank? %>
  <tr>
    <td colspan="3">No hay sedes disponibles para las especialidades seleccionadas.</td>
  </tr>
<% else %>
  <% sedes.each do |s| %>
    <tr>
      <td>
        <div class="checkboxConvContainer">
          <input
            type="checkbox"
            class="checkbox rowCheckboxSede"
            name="sedes_codigos[]"
            value="<%= s[:extension_id].presence || s[:regional_id] %>"
          >
          Seleccionar
        </div>
      </td>

      <td><%= h(s[:regional]) %></td>
      <td><%= h(s[:extension].presence || "-") %></td>
    </tr>
  <% end %>
<% end %>