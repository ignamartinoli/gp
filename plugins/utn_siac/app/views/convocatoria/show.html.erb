<div class="div_section">
  <h3 class="siac_title">
    CONVOCATORIA: <%= @convocatoria.nombre %>
  </h3>
  <br>
  <h3>
    <strong>Fecha cierre:</strong>
    <%= @convocatoria.fecha_hasta.strftime("%d/%m/%Y") %>
  </h3>

  <%= flash[:debug] %>
  <table class="table custom-table">
    <thead>
    <tr>
      <th scope="col">Facultad Regional</th>
      <th scope="col">Extensión Aulica</th>
      <th scope="col">Usuario Encargado</th>
      <th scope="col">Etapa Actual</th>
      <th scope="col">Acciones</th>
    </tr>
    </thead>
    <tbody>
    <% @sedes.each do |sede| %>
      <tr>
        <td>
          <%= sede.regional&.nombre || "-" %>
        </td>

        <td>
          <%= sede.nombre %>
        </td>

        <td>
          <% usuario = @clientes_por_regional[sede.regional&.id] %>

          <% if usuario.present? %>
            <%= "#{usuario.firstname} #{usuario.lastname}" %>
          <% else %>
            -
          <% end %>
        </td>


        <td>
            <span class="estado-etapa <%= @convocatoria.etapa.to_s.downcase %>">
              <%= @convocatoria.etapa %>
            </span>
        </td>

        <td>
          <div class="action_bar solo-visual">

              <span class="tooltip disabled">
                <span class="tooltiptext">Marcar convocatoria (próximamente)</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                     fill="currentColor" class="bi bi-bookmark" viewBox="0 0 16 16">
                  <path d="M2 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v13.5a.5.5 0 0 1-.777.416L8 13.101l-5.223 2.815A.5.5 0 0 1 2 15.5z"/>
                </svg>
              </span>

            <%= link_to admin_cargar_datos_regional_path(@convocatoria.id, sede.regional.id), class: "tooltip" do %>
                <span class="tooltiptext">Editar datos (Administrador)</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil" viewBox="0 0 16 16">
                  <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325"/>
                </svg>
            <% end %>

            <%= link_to admin_ver_datos_regional_path(@convocatoria.id, sede.regional.id), class: "tooltip" do %>
                <span class="tooltiptext">Vista previa (Solo lectura)</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye" viewBox="0 0 16 16">
                  <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
                  <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
                </svg>
            <% end %>

            <span class="tooltip disabled">
                <span class="tooltiptext">Ver detalles (próximamente)</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                     fill="currentColor" class="bi bi-info-circle" viewBox="0 0 16 16">
                  <path d="M8 15A7 7 0 1 0 8 1z"/>
                  <circle cx="8" cy="4.5" r="1"/>
                </svg>
              </span>

            <span class="tooltip disabled">
                <span class="tooltiptext">Eliminar convocatoria (no disponible)</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                     fill="currentColor" class="bi bi-trash3 disabled" viewBox="0 0 16 16">
                  <path d="M6.5 1h3a.5.5 0 0 1 .5.5z"/>
                </svg>
              </span>

          </div>
        </td>
      </tr>
    <% end %>
    <tr class="paginationTr">
      <td colspan="5">
        <div class="pagination_menu">
          <%= paginate @sedes %>
        </div>
      </td>
    </tr>
    </tbody>

  </table>
  <div class="submit-container">
    <%= link_to "Volver a las convocatorias", convocatorias_path, class: "siac_button" %>
  </div>
</div>


<% content_for :header_tags do %>
  <%= stylesheet_link_tag "siac.css", plugin: :utn_siac %>
  <%= javascript_include_tag "funciones_siac", plugin: :utn_siac %>
<% end %>
