<%= form_with url: update_componente_path(params[:id]),
              method: :patch,
              id: "formComponente",
              scope: :componente,
              local: true do |f| %>

  <!-- =========================
       PARÁMETROS GENERALES
  ========================== -->
  <div class="div_section">
    <h3 class="siac_title">Editar Componente</h3>
    <hr>
    <h3>Parámetros Generales</h3>

    <div class="field-container">
      <div class="long-field-4">
        <div class="lf4c1"><%= f.label :nombre, 'Nombre de Componente: ' %></div>
        <div class="lf4c2">
          <span class="tooltip">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-info-circle-fill" viewBox="0 0 16 16">
              <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2"/>
            </svg>
            <span class="tooltiptext">Nombre representativo para identificar la componente.</span>
          </span>
        </div>
        <div class="lf4c3"><%= f.text_field :nombre, id: 'inputNombreComponente' %></div>
        <div class="lf4c4 errorNombre"></div>
      </div>
    </div>

    <div class="field-container">
      <div class="long-field-4">
        <div class="lf4c1"><%= f.label :descripcion, 'Descripción de Componente: ' %></div>
        <div class="lf4c2">
          <span class="tooltip">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-info-circle-fill" viewBox="0 0 16 16">
              <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006/.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2"/>
            </svg>
            <span class="tooltiptext">Descripción breve sobre la función de la componente.</span>
          </span>
        </div>
        <div class="lf4c3"><%= f.text_field :descripcion, id:'inputDescripcionComponente' %></div>
        <div class="lf4c4 errorDescripcion"></div>
      </div>
    </div>

    <div class="field-container">
      <div class="long-field-4">
        <div class="lf4c1"><%= f.label :dimension_id, 'Dimensión:' %></div>
        <div class="lf4c2">
          <span class="tooltip">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-info-circle-fill" viewBox="0 0 16 16">
              <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006/.399-.287-.47 l-.451-.081.082/.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2"/>
            </svg>
            <span class="tooltiptext">Dimensión relacionada a la componente.</span>
          </span>
        </div>
        <div class="lf4c3">
          <%= f.select :dimension_id,
              options_from_collection_for_select(@dimensiones, :id, :dimension, @componente&.dimension_id),
              { include_blank: 'Selecciona una opción' },
              { id: 'componenteDimensionId' } %>
        </div>
        <div class="lf4c4 errorDimension"></div>
      </div>
    </div>
  </div>

  <!-- CONVOCATORIA -->
  <div class="div_section">
    <h3 class="siac_title">Campos</h3>
    <hr>

    <div id="campos-convo">
      <template class="campo-template">
        <%= fields_for "componente[campos_attributes][NEW_RECORD]", Campo.new do |cf| %>
          <%= render "campo_fields", cf: cf, idx: "NEW_RECORD", tipos_campo: @tipos_campo, autoeval: false %>
        <% end %>
      </template>

      <% (@componente.campos_convo || []).each do |campo| %>
        <%= fields_for "componente[campos_attributes][#{campo.id}]", campo do |cf| %>
          <%= render "campo_fields", cf: cf, idx: campo.id, tipos_campo: @tipos_campo, autoeval: false %>
        <% end %>
      <% end %>
    </div>

    <div class="buttonera-1-c">
      <%= link_to "+ Agregar un nuevo Campo a la Componente", "#", id: "add_field_convo", class: "siac_button" %>
    </div>
  </div>

  <!-- AUTOEVALUACIÓN -->
  <div class="div_section">
    <h3 class="siac_title">Autoevaluación</h3>
    <hr>

    <div id="campos-autoeval">
      <template class="campo-template">
        <%= fields_for "componente[campos_attributes][NEW_RECORD]", Campo.new do |cf| %>
          <%= render "campo_fields", cf: cf, idx: "NEW_RECORD", tipos_campo: @tipos_campo, autoeval: true %>
        <% end %>
      </template>

      <% (@componente.campos_autoeval || []).each do |campo| %>
        <%= fields_for "componente[campos_attributes][#{campo.id}]", campo do |cf| %>
          <%= render "campo_fields", cf: cf, idx: campo.id, tipos_campo: @tipos_campo, autoeval: true %>
        <% end %>
      <% end %>
    </div>

    <div class="buttonera-1-c">
      <%= link_to "+ Agregar un nuevo Campo a la Autoevaluación", "#", id: "add_field_autoeval", class: "siac_button" %>
    </div>
  </div>

  <!-- SUBMIT -->
  <div class="submit-container">
    <input type="submit" id="inputSubmit" class="submit siac_button" value="Actualizar Componente">
    <%= link_to 'Volver a componentes', componentes_path %>
  </div>

<% end %>

<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'siac.css', plugin: :utn_siac %>
  <%= javascript_include_tag 'componentes_v2', plugin: :utn_siac %>
  <%= csrf_meta_tags %>
<% end %>
